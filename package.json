{
  "name": "crafthub",
  "displayName": "CraftHub — JSON Table Editor",
  "description": "Edit JSON arrays as an interactive table with inline editing, nested object/array support, search, and seamless toggle to raw JSON.",
  "version": "1.0.3",
  "publisher": "c3n9",
  "engines": {
    "vscode": "^1.71.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/c3n9/CraftHubExtension"
  },
  "categories": [
    "Other",
    "Data Science",
    "Formatters"
  ],
  "keywords": [
    "json",
    "table",
    "editor",
    "viewer",
    "data"
  ],
  "icon": "images/icon.png",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "jsonTableEditor.editor",
        "displayName": "JSON Table Editor",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "crafthub.toggleView",
        "title": "Toggle Table / Text View",
        "icon": "./images/craftHub.svg"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "crafthub.toggleView",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.71.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
